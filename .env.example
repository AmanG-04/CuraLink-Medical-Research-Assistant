# Shared local development defaults
CLIENT_ORIGIN=http://localhost:5173

# Server
PORT=5000
MONGODB_URI=

# Hugging Face Inference (required if you disable fallback)
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_FALLBACK_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_TIMEOUT_MS=30000

# NCBI/PubMed. NCBI recommends a tool name and email for E-utilities clients.
NCBI_API_KEY=
NCBI_TOOL=curalink
NCBI_EMAIL=

# Retrieval sizes. Keep combined candidates in the 50-300 range.
OPENALEX_PAGE_SIZE=100
PUBMED_RETMAX=80
CLINICAL_TRIALS_PAGE_SIZE=80
API_CACHE_TTL_MINUTES=30
